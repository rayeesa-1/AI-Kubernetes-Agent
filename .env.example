# Copy to .env in this folder. Never commit the populated file.
# Your existing OpenRouter key. InsForge is used only for auth, history, and realtime.
OPENROUTER_API_KEY=
# Select a model available to your key that supports JSON object response mode.
OPENROUTER_MODEL=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1800

# Your InsForge project API base URL, e.g. https://your-project.insforge.app
INSFORGE_URL=
# Server-only project API key used for history writes. NEVER use a NEXT_PUBLIC_ prefix.
INSFORGE_API_KEY=
# false for local http://localhost; true when UI/API are served over HTTPS.
SESSION_COOKIE_SECURE=false
